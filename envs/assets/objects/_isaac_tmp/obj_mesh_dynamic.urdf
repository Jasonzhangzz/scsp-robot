<?xml version="1.0"?>
<robot name="mesh_obj">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="9.537433673060628e-06" ixy="0" ixz="0" iyy="1.710366193429783e-05" iyz="0" izz="1.4607894411330288e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="obj_mesh_visual.stl" scale="1 1 1"/>
      </geometry>
      <material name="obj_color">
        <color rgba="0.2 0.6 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="obj_mesh_collision.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
</robot>
