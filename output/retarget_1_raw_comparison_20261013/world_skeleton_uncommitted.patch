+def sequence_from_sdk(sequence, commands):
+    """Use the same solved human bones for finger q, wrist alignment and source poses."""
+    from dataclasses import replace
+    from scipy.spatial.transform import Rotation
+    positions, rotations = {}, {}
+    tips = np.asarray([4, 8, 12, 16, 20])
+    for side in ("left", "right"):
+        positions[side] = np.asarray(commands[f"{side}_skeleton_position_world"], dtype=np.float64)
+        quaternion = np.asarray(commands[f"{side}_skeleton_orientation_world_xyzw"], dtype=np.float64)
+        if positions[side].shape != (len(sequence.frame_indices), 21, 3):
+            raise ValueError(f"{side}: SDK skeleton and requested frames are misaligned")
+        rotations[side] = Rotation.from_quat(quaternion.reshape(-1, 4)).as_matrix().reshape(-1, 21, 3, 3)
+    return replace(sequence, positions=positions, rotations=rotations,
+        tip_positions={side: positions[side][:, tips] for side in positions},
+        tip_rotations={side: rotations[side][:, tips] for side in rotations})
+
+
